# Build the standalone refutations note.  It reuses the paper's notation
# macros, so pdflatex must see the paper directory on its input path.
PAPER_DIR ?= ../../impredicative/paper
refutations.pdf: refutations.tex $(PAPER_DIR)/macro.tex
	TEXINPUTS=$(PAPER_DIR): pdflatex -interaction=nonstopmode refutations.tex
	TEXINPUTS=$(PAPER_DIR): pdflatex -interaction=nonstopmode refutations.tex

clean-refutations:
	rm -f refutations.aux refutations.log refutations.out refutations.pdf
