-- CONTROL for thm_complete_subtyping_reachable_reject_pipe.mle: met.exe
-- ACCEPTS this.  [pipe]'s type is that file's with [r] ALREADY
-- instantiated to (∀c.[](c→c)) → unit; the term is character-identical.
--
-- What it shows: with [r] concrete the counterpart carries the ∀, so the
-- inherited information licenses the instantiation and no flexible ever
-- faces the ∀-carrying payload (the trace has SolE-Arrow/SolE-Var and
-- U-ForallInh — the ∀ is MATCHED — instead of SolE-FlexR).
--
-- ⚠️ It does NOT show that the declarative system accepts the
-- counterexample file: that step would need pipe's ∀r instantiated with a
-- polytype whose TAG nothing can pay (no inherited ∀ in the counterpart).
-- Concluding otherwise was the retracted error; docs/PAPER-GAPS.md.

type unit = Unit

val arg : []((forall c . [](c -> c)) -> unit)
let arg g = Unit

val pipe : []( ( (forall b . [](b -> b)) -> ((forall c . [](c -> c)) -> unit) ) -> ((forall c . [](c -> c)) -> unit) )

let test = pipe (fun g -> g arg)
