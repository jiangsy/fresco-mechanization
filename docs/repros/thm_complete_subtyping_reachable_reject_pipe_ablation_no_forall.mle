-- ABLATION for thm_complete_subtyping_reachable_reject_pipe.mle: met.exe
-- ACCEPTS this.  Only [arg]'s type changes — the ∀ below the head is gone
-- ((∀c.[](c→c)) → unit  becomes  unit → unit); the term is
-- character-identical and [pipe] still has the polymorphic [r].
--
-- ⭐ The SolE-FlexR collapse STILL HAPPENS here (the trace is identical
-- through SolS-Check / SolE-FlexR / U-FlexL / U-Assign-SolveM) — but the
-- assignment it then demands is [unit → unit], a MONOTYPE, so
-- Assign-SolveM succeeds and the run continues.  So what the algorithm
-- cannot do is recover a POLYTYPE it has discarded — and correspondingly
-- the declarative system will not guess one without an inherited ∀ to pay
-- for it, which is why the un-ablated file is rejected by BOTH systems.

type unit = Unit

val arg : [](unit -> unit)
let arg x = Unit

val pipe : forall r . []( ( (forall b . [](b -> b)) -> r ) -> r )

let test = pipe (fun g -> g arg)
