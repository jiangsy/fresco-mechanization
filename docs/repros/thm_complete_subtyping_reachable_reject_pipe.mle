-- ⚠️ NOT A COUNTEREXAMPLE — BOTH SYSTEMS REJECT THIS.  Retained as
-- documentation of the paper's own §2.9 limitations 2 and 3.
--
-- met.exe rejects:
--   Error: this expression has type ˆx1 but expected an expression
--          of type 👻.(∀ c : Any . [] (c → c)) → unit
--
-- and so does the DECLARATIVE system, so the rejection is CORRECT.  A
-- polytype instantiation must be PAID FOR by an inherited ∀ in the
-- counterpart (the paper's "never guess polymorphism out of thin air"):
-- d_sub__forall_l_untagged runs its premise at Ψ ∪ Ψ' with d_tags Ψ' ph;
-- the ONLY d_consis rule that puts a tag into Ψ is
-- d_consis__forall_inh_tagged, whose counterpart must be btyp_all_inh; and
-- d_sub__infer demands Ψ = ∅.  Here the argument's skeleton is 👻(◇ → ◇),
-- which carries no ∀ at r's position, so r := (∀c.[](c→c)) → unit is
-- unpayable — and pipe's r and g's b need each other's information.
--
-- That mutual dependency is §2.9's THIRD limitation ("only flowing back
-- and forth once"): the program becomes typeable if pipe's skeleton first
-- flows INTO (fun g -> g arg).  The coarseness of 👻(◇ → ◇) is §2.9's
-- SECOND limitation ("ghosts are nameless").
--
-- ⚠️ An earlier revision of this file claimed the declarative system
-- ACCEPTS this program (refuting thm:complete-subtyping on programs).
-- WITHDRAWN — see docs/PAPER-GAPS.md (2026-08-03).  The rule-level
-- refutation of the mech's [main_forall] (cex/probe_double_occ_run.v)
-- is unaffected; only the REACHABILITY claim was wrong.

type unit = Unit

val arg : []((forall c . [](c -> c)) -> unit)
let arg g = Unit

val pipe : forall r . []( ( (forall b . [](b -> b)) -> r ) -> r )

let test = pipe (fun g -> g arg)
