# Build the standalone ghost-capture note.  It reuses the paper's notation
# macros, so pdflatex must see the paper directory on its input path.
PAPER_DIR ?= ../../impredicative/paper
ghost-capture.pdf: ghost-capture.tex $(PAPER_DIR)/macro.tex
	TEXINPUTS=$(PAPER_DIR): pdflatex -interaction=nonstopmode ghost-capture.tex
	TEXINPUTS=$(PAPER_DIR): pdflatex -interaction=nonstopmode ghost-capture.tex

clean-ghost-capture:
	rm -f ghost-capture.aux ghost-capture.log ghost-capture.out ghost-capture.pdf
