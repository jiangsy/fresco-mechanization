(** DEFERRED / ARCHIVED — NOT IN THE BUILD.  DO NOT RENAME BACK TO .v AS-IS.
    (The Makefile globs `*.v`; the `.deferred` suffix is what keeps it out.)

    ============================ THIS FILE HANGS ============================
    `coqc` burns 90s+ of CPU at 98% without terminating.  Culprit: in
    [swap_ptyp_subst],

        repeat match goal with |- context [ if ?t then _ else _ ] => destruct t end

    `destruct t` does NOT eliminate that [if] — [subst_ptyp_in_ptyp]'s scrutinee
    elaborates to [@eq_dec ptypvar EqDec_eq_of_X ...], which a plain [destruct]
    does not abstract.  So the [if] survives, the [match] fires again, and
    [repeat] loops forever.  The working form is
        destruct (@eq_dec ptypvar EqDec_eq_of_X x y)
    (Same gotcha bites [subst_pskl_in_pskl] — see the note in prop_flex.v.)
    There are also ~10 UNSCOPED [fsetdec] calls, which are minutes-slow here.

    ======================= BUT DON'T JUST FIX THE HANG ======================
    The 960 lines of atom-swapping / equivariance machinery below exist to work
    around a REAL obstacle, and they are the WRONG way around it.

    [a_consis_sym]'s output must be EXISTENTIALLY quantified (the [Flex] rule
    outputs the SUBJECT's variable, so swapping [β̂] α̂ ≈ α̂  to  [α̂] β̂ ≈ β̂
    changes Q from α̂ to β̂).  That collides with cofinite quantification: in
    ForallInh the IH gives some [Q'_α] for each fresh [α ∉ L], but the conclusion
    needs a SINGLE [Q'] with [open Q' α] for EVERY [α].  You cannot just pick one.

    This codebase already has a resolution, and it is not swapping.  See
    [d_consis_compose] (docs/PAPER-GAPS.md, and the compose-tags-witness note):
    it dissolved exactly this "different witness per fresh variable" blocker by
    making the output an EXPLICIT WITNESS FUNCTION of the inputs — invariant
    under opening a variable — instead of an existential.  Retry THAT way.  It
    should be a fraction of this size and need no equivariance library.

    ============================== WHY IT EXISTS =============================
    It would upgrade our verdict on an IMPLEMENTATION discrepancy from
    "argued benign" to "proved benign": the reference implementation's
    [U-Flex-Flex-Assign] (paper/artifact/implementation/lib/type.ml:316-321)
    passes its two [join_sk] arguments in the OPPOSITE order from the paper —
    input α̂[τ/γ̂], subject β̂[τ/γ̂], where the paper means subject α̂, input β̂.
    (The implementation is internally inconsistent: its own [U-Assign-Assign]
    gets the slots right.)  We argue this is harmless because consistency is
    mirror-symmetric under (P₀ ↔ P, Δ₁ ↔ Δ₂), and at that rule Δ₁ = Δ₂ = ∅ and
    the output Q is discarded — so both caveats vanish.  This file would prove
    that argument.

    PRIORITY: LOW.  It changes NOTHING in our mechanization — our rules already
    follow the paper.  It only characterises someone else's bug, which we are
    reporting to WT regardless.  Full context: docs/PAPER-GAPS.md, sections
    "IMPLEMENTATION DISCREPANCY" and "DEFERRED — a_consis_sym". *)

(** * Symmetry of algorithmic consistency (and of variable unification).

    Algorithmic consistency [Θ0 ⊢ₐ[F][Δ1 | Δ2 | P0] P ≈ Q ⊣ Θ1] is MIRROR
    SYMMETRIC: swapping the INPUT [P0] with the SUBJECT [P] (and, in lockstep,
    the two auxiliary binder sets [Δ1 ∣ Δ2]) maps the 14 rules onto each other

      Ghost      ↔ GhostR        ForallSyn ↔ UnivGhost1
      UnivGhost2 ↔ UnivGhostR    FlexL     ↔ FlexR
      Unit / Rigid / Arrow / ForallInh / UnivGhost / Flex   (self-mirrors)

    and the 6 unification rules likewise (Flex-Flex-L ↔ Flex-Flex-R, the rest
    self-mirrors; Flex-Flex-Assign's premise is a two-slot consistency, so the
    two judgments must be proved symmetric TOGETHER).

    The OUTPUT CONTEXT [Θ1] is preserved on the nose.  The output SKELETON is
    not: rule [Flex] returns the SUBJECT's variable, so [·⊢[β̂] α̂ ≈ α̂] mirrors
    to [·⊢[α̂] β̂ ≈ β̂] — same context, different output.  Hence the mirror's
    output is existentially quantified.

    [a_assign] needs NO symmetry: [FlexL] and [FlexR] carry the very SAME
    assignment premise, so the mirror re-uses it as a black box.  Its motive in
    the mutual induction is therefore trivially [True].

    The cofinite rules ([ForallInh], [ForallSyn], [UnivGhost1]) need a single
    binder BODY for the mirror's output, while the induction hypothesis only
    offers a per-[α] witness.  We reconcile the two with EQUIVARIANCE: the three
    judgments are stable under any atom transposition (Section 2 below), which
    is exactly the renaming principle that lets one witness be transported to
    every fresh [α].  Equivariance is stated with a transposition (rather than a
    one-way renaming) because a transposition is a bijection: it needs NO
    freshness side conditions, so every rule — including [Assign-SolveM]'s
    guessed names — maps to itself unconditionally. *)

Require Import Coq.Lists.List.
Require Import Coq.Program.Equality.
Require Import Metalib.Metatheory.

Require Import src.frost.notations.
Require Import src.frost.coercions.
Require Import src.frost.predicates.
Require Import src.frost.ltac_utils.
Require Import src.frost.prop_ln.
Require Import src.frost.decl.def_extra.
Require Import src.frost.algo.def_extra.

Set Implicit Arguments.

(* ===================================================================== *)
(*  1.  Transpositions [(a b)] on atoms, skeletons, types, contexts.       *)
(* ===================================================================== *)

Definition swap_atom (a b x : atom) : atom :=
  if x == a then b else if x == b then a else x.

(** Keep [simpl] from unfolding the transposition inside skeletons. *)
Arguments swap_atom : simpl never.

Fixpoint swap_pskl (a b : atom) (P : pskl) : pskl :=
  match P with
  | pskl_unit        => pskl_unit
  | pskl_var_b n     => pskl_var_b n
  | pskl_var_f x     => pskl_var_f (swap_atom a b x)
  | pskl_arrow P1 P2 => pskl_arrow (swap_pskl a b P1) (swap_pskl a b P2)
  | pskl_all_syn P1  => pskl_all_syn (swap_pskl a b P1)
  | pskl_hole        => pskl_hole
  | pskl_tophole P1  => pskl_tophole (swap_pskl a b P1)
  end.

Fixpoint swap_ptyp (a b : atom) (A : ptyp) : ptyp :=
  match A with
  | ptyp_unit        => ptyp_unit
  | ptyp_var_b n     => ptyp_var_b n
  | ptyp_var_f x     => ptyp_var_f (swap_atom a b x)
  | ptyp_arrow A1 A2 => ptyp_arrow (swap_ptyp a b A1) (swap_ptyp a b A2)
  | ptyp_all A1      => ptyp_all (swap_ptyp a b A1)
  end.

Definition swap_abind (a b : atom) (bd : abind) : abind :=
  match bd with
  | abind_tvar             => abind_tvar
  | abind_var_typ A        => abind_var_typ (swap_ptyp a b A)
  | abind_var_skl P        => abind_var_skl (swap_pskl a b P)
  | abind_flex_mono        => abind_flex_mono
  | abind_flex_mono_def A  => abind_flex_mono_def (swap_ptyp a b A)
  end.

Fixpoint swap_aenv (a b : atom) (Θ : aenv) : aenv :=
  match Θ with
  | nil            => nil
  | (x, bd) :: Θ'  => (swap_atom a b x, swap_abind a b bd) :: swap_aenv a b Θ'
  end.

Definition ftvar_in_abind (bd : abind) : atoms :=
  match bd with
  | abind_tvar            => empty
  | abind_var_typ A       => ftvar_in_ptyp A
  | abind_var_skl P       => ftvar_in_pskl P
  | abind_flex_mono       => empty
  | abind_flex_mono_def A => ftvar_in_ptyp A
  end.

(** All atoms a context mentions: its domain plus the free variables of every
    payload (a flexible definition [α̂ ≔ τ] may mention a rigid variable). *)
Fixpoint ftvar_in_aenv (Θ : aenv) : atoms :=
  match Θ with
  | nil           => empty
  | (x, bd) :: Θ' => add x (ftvar_in_abind bd `union` ftvar_in_aenv Θ')
  end.

Definition swap_atoms (a b : atom) (S : atoms) : atoms :=
  AtomSetImpl.union
    (AtomSetImpl.remove a (AtomSetImpl.remove b S))
    (AtomSetImpl.union
       (if AtomSetImpl.mem a S then singleton b else empty)
       (if AtomSetImpl.mem b S then singleton a else empty)).

(** ** Atoms *)

Lemma swap_atom_invol : forall a b x, swap_atom a b (swap_atom a b x) = x.
Proof.
  intros a b x. unfold swap_atom.
  destruct (x == a) as [Hxa | Hxa].
  - destruct (b == a); destruct (b == b); congruence.
  - destruct (x == b) as [Hxb | Hxb].
    + destruct (a == a); congruence.
    + destruct (x == a); destruct (x == b); congruence.
Qed.

Lemma swap_atom_neq : forall a b x, x <> a -> x <> b -> swap_atom a b x = x.
Proof.
  intros. unfold swap_atom. destruct (x == a); destruct (x == b); congruence.
Qed.

Lemma swap_atom_l : forall a b, swap_atom a b a = b.
Proof. intros. unfold swap_atom. destruct (a == a); congruence. Qed.

Lemma swap_atom_r : forall a b, swap_atom a b b = a.
Proof.
  intros. unfold swap_atom. destruct (b == a); destruct (b == b); congruence.
Qed.

Lemma swap_atom_inj : forall a b x y,
  swap_atom a b x = swap_atom a b y -> x = y.
Proof.
  intros * H.
  assert (swap_atom a b (swap_atom a b x) = swap_atom a b (swap_atom a b y))
    by (rewrite H; auto).
  repeat rewrite swap_atom_invol in *. auto.
Qed.

(** ** Atom sets *)

Lemma swap_atoms_iff : forall a b S x,
  x `in` swap_atoms a b S <-> swap_atom a b x `in` S.
Proof.
  intros. unfold swap_atoms, swap_atom.
  destruct (AtomSetImpl.mem a S) eqn:Ha;
    destruct (AtomSetImpl.mem b S) eqn:Hb;
    try rewrite <- AtomSetFacts.mem_iff in Ha;
    try rewrite <- AtomSetFacts.not_mem_iff in Ha;
    try rewrite <- AtomSetFacts.mem_iff in Hb;
    try rewrite <- AtomSetFacts.not_mem_iff in Hb;
    destruct (x == a); destruct (x == b); subst;
    split; intros; try fsetdec.
Qed.

Lemma swap_atoms_notin : forall a b S x,
  x `notin` swap_atoms a b S <-> swap_atom a b x `notin` S.
Proof.
  intros. split; intros H Hc; apply H.
  - apply swap_atoms_iff; auto.
  - apply swap_atoms_iff in Hc; auto.
Qed.

Lemma swap_atoms_empty : forall a b, swap_atoms a b empty [=] empty.
Proof.
  intros. intros x. split; intros H; try fsetdec.
  apply swap_atoms_iff in H. fsetdec.
Qed.

Lemma swap_atoms_add : forall a b x S,
  swap_atoms a b (add x S) [=] add (swap_atom a b x) (swap_atoms a b S).
Proof.
  intros. intros y. split; intros H.
  - apply swap_atoms_iff in H.
    apply AtomSetFacts.add_iff in H. destruct H as [H | H].
    + assert (y = swap_atom a b x) as ->
        by (apply swap_atom_inj with (a := a) (b := b);
            rewrite swap_atom_invol; auto).
      fsetdec.
    + assert (y `in` swap_atoms a b S) by (apply swap_atoms_iff; auto).
      fsetdec.
  - apply swap_atoms_iff.
    apply AtomSetFacts.add_iff in H. destruct H as [H | H].
    + subst. rewrite swap_atom_invol. fsetdec.
    + apply swap_atoms_iff in H. fsetdec.
Qed.

Lemma swap_atoms_id : forall a b S,
  a `notin` S -> b `notin` S -> swap_atoms a b S [=] S.
Proof.
  intros * Ha Hb y. split; intros H.
  - apply swap_atoms_iff in H.
    destruct (y == a); destruct (y == b); subst;
      try rewrite swap_atom_l in H; try rewrite swap_atom_r in H;
      try rewrite swap_atom_neq in H; auto; try fsetdec.
  - apply swap_atoms_iff.
    destruct (y == a); destruct (y == b); subst;
      try rewrite swap_atom_l; try rewrite swap_atom_r;
      try rewrite swap_atom_neq; auto; try fsetdec.
Qed.

(** ** Skeletons *)

Lemma swap_pskl_invol : forall a b P, swap_pskl a b (swap_pskl a b P) = P.
Proof.
  induction P; simpl; f_equal; auto using swap_atom_invol.
Qed.

Lemma swap_ptyp_invol : forall a b A, swap_ptyp a b (swap_ptyp a b A) = A.
Proof.
  induction A; simpl; f_equal; auto using swap_atom_invol.
Qed.

Lemma swap_pskl_fresh : forall a b P,
  a `notin` ftvar_in_pskl P -> b `notin` ftvar_in_pskl P ->
  swap_pskl a b P = P.
Proof.
  induction P; simpl; intros; f_equal; auto.
  - rewrite swap_atom_neq; auto.
Qed.

Lemma swap_ptyp_fresh : forall a b A,
  a `notin` ftvar_in_ptyp A -> b `notin` ftvar_in_ptyp A ->
  swap_ptyp a b A = A.
Proof.
  induction A; simpl; intros; f_equal; auto.
  - rewrite swap_atom_neq; auto.
Qed.

Lemma swap_atoms_singleton : forall a b x,
  swap_atoms a b (singleton x) [=] singleton (swap_atom a b x).
Proof.
  intros. intros y. split; intros H.
  - apply swap_atoms_iff in H.
    assert (swap_atom a b y = x) by fsetdec.
    assert (y = swap_atom a b x) as ->; [ | fsetdec ].
    rewrite <- H0. rewrite swap_atom_invol. auto.
  - apply swap_atoms_iff.
    assert (y = swap_atom a b x) by fsetdec. subst.
    rewrite swap_atom_invol. fsetdec.
Qed.

Lemma swap_atoms_union : forall a b S1 S2,
  swap_atoms a b (S1 `union` S2)
  [=] swap_atoms a b S1 `union` swap_atoms a b S2.
Proof.
  intros. intros y. split; intros H.
  - apply swap_atoms_iff in H.
    apply AtomSetFacts.union_iff in H. destruct H as [H | H];
      [ assert (y `in` swap_atoms a b S1) by (apply swap_atoms_iff; auto)
      | assert (y `in` swap_atoms a b S2) by (apply swap_atoms_iff; auto) ];
      fsetdec.
  - apply swap_atoms_iff.
    apply AtomSetFacts.union_iff in H. destruct H as [H | H];
      apply swap_atoms_iff in H; fsetdec.
Qed.

Lemma ftvar_in_swap_pskl : forall a b P,
  ftvar_in_pskl (swap_pskl a b P) [=] swap_atoms a b (ftvar_in_pskl P).
Proof.
  intros a b P.
  induction P as [ | n | x | P1 IH1 P2 IH2 | P1 IH1 | | P1 IH1 ]; simpl;
    try (rewrite swap_atoms_empty; fsetdec); try assumption.
  - rewrite swap_atoms_singleton. fsetdec.
  - rewrite swap_atoms_union. fsetdec.
Qed.

Lemma swap_pskl_open_rec : forall a b P Q k,
  swap_pskl a b (open_pskl_wrt_pskl_rec k Q P)
  = open_pskl_wrt_pskl_rec k (swap_pskl a b Q) (swap_pskl a b P).
Proof.
  induction P; intros; simpl; f_equal; auto.
  destruct (lt_eq_lt_dec n k) as [[?|?]|?]; reflexivity.
Qed.

Lemma swap_pskl_open : forall a b P Q,
  swap_pskl a b (open_pskl_wrt_pskl P Q)
  = open_pskl_wrt_pskl (swap_pskl a b P) (swap_pskl a b Q).
Proof.
  intros. unfold open_pskl_wrt_pskl. apply swap_pskl_open_rec.
Qed.

Lemma swap_pskl_open_var : forall a b P x,
  swap_pskl a b (open_pskl_wrt_pskl P (pskl_var_f x))
  = open_pskl_wrt_pskl (swap_pskl a b P) (pskl_var_f (swap_atom a b x)).
Proof. intros. apply swap_pskl_open. Qed.

Lemma swap_ptyp_open_rec : forall a b A B k,
  swap_ptyp a b (open_ptyp_wrt_ptyp_rec k B A)
  = open_ptyp_wrt_ptyp_rec k (swap_ptyp a b B) (swap_ptyp a b A).
Proof.
  induction A; intros; simpl; f_equal; auto.
  destruct (lt_eq_lt_dec n k) as [[?|?]|?]; reflexivity.
Qed.

Lemma swap_ptyp_open_var : forall a b A x,
  swap_ptyp a b (open_ptyp_wrt_ptyp A (ptyp_var_f x))
  = open_ptyp_wrt_ptyp (swap_ptyp a b A) (ptyp_var_f (swap_atom a b x)).
Proof. intros. unfold open_ptyp_wrt_ptyp. apply swap_ptyp_open_rec. Qed.

Lemma swap_pskl_subst : forall a b P Q x,
  swap_pskl a b (subst_pskl_in_pskl Q x P)
  = subst_pskl_in_pskl (swap_pskl a b Q) (swap_atom a b x) (swap_pskl a b P).
Proof.
  intros a b P Q x. induction P as [ | n | y | P1 IH1 P2 IH2 | P1 IH1 | | P1 IH1 ];
    simpl; try solve [ f_equal; auto ].
  destruct (y == x); subst; simpl;
    repeat match goal with |- context [ if ?t then _ else _ ] => destruct t end;
    try congruence.
  match goal with H : swap_atom _ _ _ = swap_atom _ _ _ |- _ =>
    apply swap_atom_inj in H end. congruence.
Qed.

Lemma swap_ptyp_subst : forall a b A B x,
  swap_ptyp a b (subst_ptyp_in_ptyp B x A)
  = subst_ptyp_in_ptyp (swap_ptyp a b B) (swap_atom a b x) (swap_ptyp a b A).
Proof.
  intros a b A B x. induction A as [ | n | y | A1 IH1 A2 IH2 | A1 IH1 ];
    simpl; try solve [ f_equal; auto ].
  destruct (y == x); subst; simpl;
    repeat match goal with |- context [ if ?t then _ else _ ] => destruct t end;
    try congruence.
  match goal with H : swap_atom _ _ _ = swap_atom _ _ _ |- _ =>
    apply swap_atom_inj in H end. congruence.
Qed.

Lemma swap_ptyp_to_pskl : forall a b A,
  ptyp_to_pskl (swap_ptyp a b A) = swap_pskl a b (ptyp_to_pskl A).
Proof. induction A; simpl; f_equal; auto. Qed.

Lemma swap_pskl_lc : forall a b P, lc_pskl P -> lc_pskl (swap_pskl a b P).
Proof.
  intros a b P H. induction H; simpl; auto.
  apply lc_pskl_all_syn. intros x.
  specialize (H0 (swap_atom a b x)).
  rewrite swap_pskl_open_var in H0.
  rewrite swap_atom_invol in H0. exact H0.
Qed.

Lemma swap_ptyp_lc : forall a b A, lc_ptyp A -> lc_ptyp (swap_ptyp a b A).
Proof.
  intros a b A H. induction H; simpl; auto.
  apply lc_ptyp_all. intros x.
  specialize (H0 (swap_atom a b x)).
  rewrite swap_ptyp_open_var in H0.
  rewrite swap_atom_invol in H0. exact H0.
Qed.

Lemma swap_pskl_guarded : forall a b P,
  guarded_pskl P -> guarded_pskl (swap_pskl a b P).
Proof.
  intros * H. inversion H; subst; simpl; constructor; auto using swap_pskl_lc.
Qed.

Lemma swap_ptyp_mono : forall a b A, mono_ptyp A -> mono_ptyp (swap_ptyp a b A).
Proof. intros * H. induction H; simpl; constructor; auto. Qed.

(** A transposition acts as a plain renaming once the second atom is fresh. *)
Lemma swap_pskl_as_subst : forall a b P,
  b `notin` ftvar_in_pskl P ->
  swap_pskl a b P = subst_pskl_in_pskl (pskl_var_f b) a P.
Proof.
  intros a b P.
  induction P as [ | n | y | P1 IH1 P2 IH2 | P1 IH1 | | P1 IH1 ];
    simpl; intros Hb; try solve [ f_equal; auto ].
  unfold swap_atom;
    repeat match goal with |- context [ if ?t then _ else _ ] => destruct t end;
    subst; try congruence; try fsetdec.
Qed.

(** ** Contexts *)

Lemma swap_aenv_app : forall a b Θ1 Θ2,
  swap_aenv a b (Θ1 ++ Θ2) = swap_aenv a b Θ1 ++ swap_aenv a b Θ2.
Proof.
  induction Θ1 as [| [x bd] Θ1]; simpl; intros; f_equal; auto.
Qed.

Lemma swap_aenv_one : forall a b x bd,
  swap_aenv a b (x ~ bd) = (swap_atom a b x ~ swap_abind a b bd).
Proof. reflexivity. Qed.

Lemma swap_aenv_invol : forall a b Θ, swap_aenv a b (swap_aenv a b Θ) = Θ.
Proof.
  induction Θ as [| [x bd] Θ]; simpl; f_equal; auto.
  rewrite swap_atom_invol. f_equal.
  destruct bd; simpl; f_equal;
    auto using swap_pskl_invol, swap_ptyp_invol.
Qed.

Lemma swap_aenv_dom : forall a b Θ,
  dom (swap_aenv a b Θ) [=] swap_atoms a b (dom Θ).
Proof.
  induction Θ as [| [x bd] Θ]; simpl.
  - rewrite swap_atoms_empty. fsetdec.
  - rewrite swap_atoms_add. rewrite IHΘ. fsetdec.
Qed.

Lemma swap_aenv_binds : forall a b x bd Θ,
  binds x bd Θ ->
  binds (swap_atom a b x) (swap_abind a b bd) (swap_aenv a b Θ).
Proof.
  intros a b x bd Θ.
  induction Θ as [| [y bd'] Θ]; unfold binds in *; simpl; intros H.
  - contradiction.
  - destruct H as [H | H].
    + inversion H; subst. left; auto.
    + right; auto.
Qed.

Lemma swap_aenv_binds_inv : forall a b x bd Θ,
  binds (swap_atom a b x) (swap_abind a b bd) (swap_aenv a b Θ) ->
  binds x bd Θ.
Proof.
  intros * H.
  apply (@swap_aenv_binds a b) in H.
  rewrite swap_atom_invol in H.
  rewrite swap_aenv_invol in H.
  replace (swap_abind a b (swap_abind a b bd)) with bd in H; auto.
  destruct bd; simpl; f_equal;
    auto using swap_pskl_invol, swap_ptyp_invol.
Qed.

Lemma swap_aenv_uniq : forall a b Θ, uniq Θ -> uniq (swap_aenv a b Θ).
Proof.
  intros * H. induction H; simpl; auto.
  constructor; auto.
  rewrite swap_aenv_dom. apply swap_atoms_notin.
  rewrite swap_atom_invol. auto.
Qed.

Lemma swap_aenv_fresh : forall a b Θ,
  a `notin` ftvar_in_aenv Θ -> b `notin` ftvar_in_aenv Θ ->
  swap_aenv a b Θ = Θ.
Proof.
  intros a b Θ. induction Θ as [| [x bd] Θ]; simpl; intros Ha Hb; auto.
  assert (Hx : swap_atom a b x = x) by (apply swap_atom_neq; fsetdec).
  rewrite Hx. f_equal.
  - f_equal.
    destruct bd; simpl in *; f_equal;
      auto using swap_pskl_fresh, swap_ptyp_fresh.
  - apply IHΘ; fsetdec.
Qed.

Lemma dom_sub_ftvar_in_aenv : forall Θ, dom Θ [<=] ftvar_in_aenv Θ.
Proof.
  induction Θ as [| [x bd] Θ]; simpl; fsetdec.
Qed.

Lemma swap_atoms_inter : forall a b S1 S2,
  swap_atoms a b (AtomSetImpl.inter S1 S2)
  [=] AtomSetImpl.inter (swap_atoms a b S1) (swap_atoms a b S2).
Proof.
  intros. intros y. split; intros H.
  - apply swap_atoms_iff in H.
    apply AtomSetFacts.inter_iff in H. destruct H as [H1 H2].
    assert (y `in` swap_atoms a b S1) by (apply swap_atoms_iff; auto).
    assert (y `in` swap_atoms a b S2) by (apply swap_atoms_iff; auto).
    fsetdec.
  - apply swap_atoms_iff.
    apply AtomSetFacts.inter_iff in H. destruct H as [H1 H2].
    apply swap_atoms_iff in H1. apply swap_atoms_iff in H2. fsetdec.
Qed.

(* ===================================================================== *)
(*  2.  Equivariance of the auxiliary judgments.                           *)
(* ===================================================================== *)

Lemma swap_a_flex : forall a b Θ P,
  a_flex Θ P -> a_flex (swap_aenv a b Θ) (swap_pskl a b P).
Proof.
  intros * H. inversion H; subst; simpl.
  - apply a_flex__var with (Θ := swap_aenv a b Θ).
    apply (@swap_aenv_binds a b α abind_flex_mono) in H0. exact H0.
  - apply a_flex__var_def with (τ := swap_ptyp a b τ).
    apply (@swap_aenv_binds a b α (abind_flex_mono_def τ)) in H0. exact H0.
Qed.

Lemma swap_a_non_flex : forall a b Θ P,
  a_non_flex Θ P -> a_non_flex (swap_aenv a b Θ) (swap_pskl a b P).
Proof.
  intros * [Hlc Hnf]. split; [ apply swap_pskl_lc; auto | ].
  intros Hc. apply Hnf.
  apply (@swap_a_flex a b) in Hc.
  rewrite swap_aenv_invol in Hc. rewrite swap_pskl_invol in Hc. auto.
Qed.

Lemma swap_a_flex_tvar : forall a b Θ α,
  a_flex_tvar Θ α -> a_flex_tvar (swap_aenv a b Θ) (swap_atom a b α).
Proof.
  intros * H. destruct H as [H | [τ H]].
  - left. apply (@swap_aenv_binds a b α abind_flex_mono) in H. exact H.
  - right. exists (swap_ptyp a b τ).
    apply (@swap_aenv_binds a b α (abind_flex_mono_def τ)) in H. exact H.
Qed.

Lemma swap_a_guess_mono : forall a b Θ P Ξ A,
  a_guess_mono Θ P Ξ A ->
  a_guess_mono (swap_aenv a b Θ) (swap_pskl a b P)
    (swap_aenv a b Ξ) (swap_ptyp a b A).
Proof.
  intros * H. induction H; simpl.
  - apply a_guess_mono__hole.
  - apply a_guess_mono__tophole; auto.
  - apply a_guess_mono__var.
  - apply a_guess_mono__unit.
  - rewrite swap_aenv_app. apply a_guess_mono__arrow; auto.
  - apply a_guess_mono__forall with (L := swap_atoms a b L).
    intros α Hα.
    apply swap_atoms_notin in Hα.
    specialize (H0 (swap_atom a b α) Hα).
    rewrite swap_pskl_open_var in H0. rewrite swap_ptyp_open_var in H0.
    rewrite swap_atom_invol in H0. exact H0.
Qed.

Lemma swap_inter_empty : forall a b S1 S2,
  AtomSetImpl.inter S1 S2 [=] empty ->
  AtomSetImpl.inter (swap_atoms a b S1) (swap_atoms a b S2) [=] empty.
Proof.
  intros a b S1 S2 H x. split; intros Hx; try fsetdec.
  apply AtomSetFacts.inter_iff in Hx as [H1 H2].
  apply swap_atoms_iff in H1. apply swap_atoms_iff in H2.
  assert (Hin : swap_atom a b x `in` AtomSetImpl.inter S1 S2) by fsetdec.
  rewrite H in Hin. fsetdec.
Qed.

Lemma swap_notin_ftvar_pskl : forall a b x P,
  x `notin` ftvar_in_pskl P ->
  swap_atom a b x `notin` ftvar_in_pskl (swap_pskl a b P).
Proof.
  intros * H. rewrite ftvar_in_swap_pskl.
  apply swap_atoms_notin. rewrite swap_atom_invol. auto.
Qed.

(* ===================================================================== *)
(*  3.  EQUIVARIANCE of [a_assign] / [a_unify] / [a_consis].               *)
(*                                                                         *)
(*  Every rule maps to itself under a transposition [(a b)].  The used-name *)
(*  set and the two binder sets are only determined UP TO SET EQUALITY by   *)
(*  the swap (e.g. [swap(Δ ∪ {α})] and [swap Δ ∪ {swap α}] are Equal but    *)
(*  not Leibniz-equal), so the motives quantify over any set [=]-equal to   *)
(*  the swapped one — which also gives us congruence for free.              *)
(* ===================================================================== *)

Scheme a_assign_mutind := Induction for a_assign Sort Prop
  with a_unify_mutind  := Induction for a_unify  Sort Prop
  with a_consis_mutind := Induction for a_consis Sort Prop.
Combined Scheme a_auc_mutind
  from a_assign_mutind, a_unify_mutind, a_consis_mutind.

Definition assign_equiv (F : atoms) (Θ0 Ξ : aenv) (α : atom) (P : pskl)
    (Θ1 : aenv) : Prop :=
  forall a b F', F' [=] swap_atoms a b F ->
    a_assign F' (swap_aenv a b Θ0) (swap_aenv a b Ξ) (swap_atom a b α)
             (swap_pskl a b P) (swap_aenv a b Θ1).

Definition unify_equiv (F : atoms) (Θ0 : aenv) (α β : atom) (Θ1 : aenv) : Prop :=
  forall a b F', F' [=] swap_atoms a b F ->
    a_unify F' (swap_aenv a b Θ0) (swap_atom a b α) (swap_atom a b β)
            (swap_aenv a b Θ1).

Definition consis_equiv (F Δ1 Δ2 : atoms) (Θ0 : aenv) (P0 P Q : pskl)
    (Θ1 : aenv) : Prop :=
  forall a b F' Δ1' Δ2',
    F' [=] swap_atoms a b F ->
    Δ1' [=] swap_atoms a b Δ1 ->
    Δ2' [=] swap_atoms a b Δ2 ->
    a_consis F' Δ1' Δ2' (swap_aenv a b Θ0) (swap_pskl a b P0) (swap_pskl a b P)
             (swap_pskl a b Q) (swap_aenv a b Θ1).

Lemma a_auc_equiv :
  (forall F Θ0 Ξ α P Θ1, a_assign F Θ0 Ξ α P Θ1 -> assign_equiv F Θ0 Ξ α P Θ1) /\
  (forall F Θ0 α β Θ1, a_unify F Θ0 α β Θ1 -> unify_equiv F Θ0 α β Θ1) /\
  (forall F Δ1 Δ2 Θ0 P0 P Q Θ1, a_consis F Δ1 Δ2 Θ0 P0 P Q Θ1 ->
     consis_equiv F Δ1 Δ2 Θ0 P0 P Q Θ1).
Proof.
  apply a_auc_mutind;
    unfold assign_equiv, unify_equiv, consis_equiv.

  (* ---------------- a_assign ---------------- *)
  - (* Assign-UnivGhost-Id *)
    intros F Θ0 α a b F' HF. simpl. apply a_assign__univ_ghost_id.
  - (* Assign-SolveM *)
    intros F Θ0 Ξ α P βs τ Hnotin Hguess Hmono Huniq Hfresh a b F' HF.
    simpl. repeat rewrite swap_aenv_app.
    apply a_assign__solve_m with (βs := swap_aenv a b βs) (τ := swap_ptyp a b τ);
      auto using swap_notin_ftvar_pskl, swap_a_guess_mono, swap_ptyp_mono,
                 swap_aenv_uniq.
    intros γ Hγ.
    rewrite swap_aenv_dom in Hγ. apply swap_atoms_iff in Hγ.
    specialize (Hfresh _ Hγ).
    assert (Heq : F' `union` add (swap_atom a b α)
                    (dom (swap_aenv a b Ξ ++ swap_aenv a b Θ0))
              [=] swap_atoms a b (F `union` add α (dom (Ξ ++ Θ0)))).
    { rewrite <- swap_aenv_app. rewrite swap_aenv_dom.
      rewrite swap_atoms_union. rewrite swap_atoms_add. rewrite HF. fsetdec. }
    rewrite Heq. apply swap_atoms_notin. auto.
  - (* Assign-Assign *)
    intros F Θ0 Θ1 Ξ α β τ P Q Hflex Hcons IH a b F' HF.
    simpl.
    apply a_assign__assign with (τ := swap_ptyp a b τ) (Q := swap_pskl a b Q).
    + apply (@swap_a_flex_tvar a b) in Hflex. simpl in Hflex. exact Hflex.
    + specialize (IH a b (add (swap_atom a b β) F') empty empty).
      rewrite swap_aenv_app in IH.
      repeat rewrite swap_pskl_subst in IH.
      rewrite <- swap_ptyp_to_pskl in IH. simpl in IH.
      apply IH.
      * rewrite swap_atoms_add. rewrite HF. fsetdec.
      * rewrite swap_atoms_empty. fsetdec.
      * rewrite swap_atoms_empty. fsetdec.
  - (* Assign-Depend *)
    intros F Θ0 Θ1 Ξ α β P Hne Hin Hass IH a b F' HF.
    simpl. apply a_assign__depend.
    + intros Hc. apply swap_atom_inj in Hc. congruence.
    + rewrite ftvar_in_swap_pskl. apply swap_atoms_iff.
      rewrite swap_atom_invol. auto.
    + specialize (IH a b F' HF). rewrite swap_aenv_app in IH. simpl in IH.
      exact IH.
  - (* Assign-Skip *)
    intros F Θ0 Θ1 Ξ α β P Hne Hnotin Hass IH a b F' HF.
    simpl. apply a_assign__skip; auto.
    + intros Hc. apply swap_atom_inj in Hc. congruence.
    + apply swap_notin_ftvar_pskl with (a := a) (b := b) in Hnotin. exact Hnotin.
    + apply IH. rewrite swap_atoms_add. rewrite HF. fsetdec.
  - (* Assign-SkipRigid *)
    intros F Θ0 Θ1 Ξ α β P Hnotin Hass IH a b F' HF.
    simpl. apply a_assign__skip_rigid.
    + apply swap_notin_ftvar_pskl with (a := a) (b := b) in Hnotin. exact Hnotin.
    + apply IH. rewrite swap_atoms_add. rewrite HF. fsetdec.
  - (* Assign-SkipTmVar *)
    intros F Θ0 Θ1 Ξ α x Q P Hass IH a b F' HF.
    simpl. apply a_assign__skip_tm_var.
    apply IH. rewrite swap_atoms_add. rewrite HF. fsetdec.
  - (* Assign-SkipTmVar (skl) *)
    intros F Θ0 Θ1 Ξ α x Q P Hass IH a b F' HF.
    simpl. apply a_assign__skip_tm_skl.
    apply IH. rewrite swap_atoms_add. rewrite HF. fsetdec.

  (* ---------------- a_unify ---------------- *)
  - (* Flex-Flex-Id *)
    intros F Θ0 α Hflex a b F' HF.
    apply a_unify__flex_id. apply swap_a_flex_tvar. auto.
  - (* Flex-Flex-L *)
    intros F Θ0 α β Hne Hflex a b F' HF. simpl.
    apply a_unify__flex_l.
    + intros Hc. apply swap_atom_inj in Hc. congruence.
    + apply swap_a_flex_tvar. auto.
  - (* Flex-Flex-R *)
    intros F Θ0 α β Hne Hflex a b F' HF. simpl.
    apply a_unify__flex_r.
    + intros Hc. apply swap_atom_inj in Hc. congruence.
    + apply swap_a_flex_tvar. auto.
  - (* Flex-Flex-Assign *)
    intros F Θ0 Θ1 γ τ α β Q Hfa Hfb Hcons IH a b F' HF. simpl.
    apply a_unify__flex_assign with (τ := swap_ptyp a b τ) (Q := swap_pskl a b Q).
    + apply (@swap_a_flex_tvar a b) in Hfa. simpl in Hfa. exact Hfa.
    + apply (@swap_a_flex_tvar a b) in Hfb. simpl in Hfb. exact Hfb.
    + specialize (IH a b (add (swap_atom a b γ) F') empty empty).
      repeat rewrite <- swap_ptyp_to_pskl in IH.
      repeat rewrite swap_ptyp_subst in IH. simpl in IH.
      apply IH.
      * rewrite swap_atoms_add. rewrite HF. fsetdec.
      * rewrite swap_atoms_empty. fsetdec.
      * rewrite swap_atoms_empty. fsetdec.
  - (* Flex-Flex-Skip *)
    intros F Θ0 Θ1 γ α β Hne1 Hne2 Huni IH a b F' HF. simpl.
    apply a_unify__flex_skip.
    + intros Hc. apply swap_atom_inj in Hc. congruence.
    + intros Hc. apply swap_atom_inj in Hc. congruence.
    + apply IH. rewrite swap_atoms_add. rewrite HF. fsetdec.
  - (* Flex-Flex-Skip' *)
    intros F Θ0 Θ1 c bd α β Hbd Huni IH a b F' HF. simpl.
    apply a_unify__skip_other.
    + destruct Hbd as [-> | [[Q ->] | [Q ->]]]; simpl.
      * left; auto.
      * right; left; exists (swap_ptyp a b Q); auto.
      * right; right; exists (swap_pskl a b Q); auto.
    + apply IH. rewrite swap_atoms_add. rewrite HF. fsetdec.

  (* ---------------- a_consis ---------------- *)
  - (* Ghost *)
    intros F Δ1 Δ2 Θ0 P0 Hinter a b F' Δ1' Δ2' HF H1 H2. simpl.
    apply a_consis__ghost.
    rewrite H2. rewrite ftvar_in_swap_pskl. apply swap_inter_empty. auto.
  - (* Unit *)
    intros F Δ1 Δ2 Θ0 a b F' Δ1' Δ2' HF H1 H2. simpl. apply a_consis__unit.
  - (* Rigid *)
    intros F Δ1 Δ2 Θ0 α Hbinds a b F' Δ1' Δ2' HF H1 H2. simpl.
    apply a_consis__rigid.
    apply (@swap_aenv_binds a b α abind_tvar) in Hbinds. exact Hbinds.
  - (* Arrow *)
    intros F Δ1 Δ2 Θ0 Θ1 Θ2 P0a P0b P1 P2 Q1 Q2 Hc1 IH1 Hc2 IH2
      a b F' Δ1' Δ2' HF H1 H2. simpl.
    apply a_consis__arrow with (Θ1 := swap_aenv a b Θ1); auto.
  - (* ForallInh *)
    intros L F Δ1 Δ2 Θ0 Θ1 P0 P Q Hbody IH a b F' Δ1' Δ2' HF H1 H2. simpl.
    apply a_consis__forall_inh with (L := swap_atoms a b L).
    intros α Hα. apply swap_atoms_notin in Hα.
    specialize (IH (swap_atom a b α) Hα a b F'
                   (add α Δ1') (add α Δ2') HF).
    repeat rewrite swap_pskl_open_var in IH.
    simpl in IH. repeat rewrite swap_atom_invol in IH.
    apply IH.
    + rewrite swap_atoms_add. rewrite swap_atom_invol. rewrite H1. fsetdec.
    + rewrite swap_atoms_add. rewrite swap_atom_invol. rewrite H2. fsetdec.
  - (* ForallSyn *)
    intros L F Δ1 Δ2 Θ0 Θ1 P0 P Q Hbody IH a b F' Δ1' Δ2' HF H1 H2. simpl.
    apply a_consis__forall_syn with (L := swap_atoms a b L).
    intros α Hα. apply swap_atoms_notin in Hα.
    specialize (IH (swap_atom a b α) Hα a b F' Δ1' (add α Δ2') HF H1).
    repeat rewrite swap_pskl_open_var in IH.
    simpl in IH. repeat rewrite swap_atom_invol in IH.
    apply IH.
    rewrite swap_atoms_add. rewrite swap_atom_invol. rewrite H2. fsetdec.
  - (* UnivGhost *)
    intros F Δ1 Δ2 Θ0 Θ1 P0 P Q Hc IH a b F' Δ1' Δ2' HF H1 H2. simpl.
    apply a_consis__univ_ghost; auto.
  - (* UnivGhost1 *)
    intros L F Δ1 Δ2 Θ0 Θ1 P0 P Q Hbody IH a b F' Δ1' Δ2' HF H1 H2. simpl.
    apply a_consis__univ_ghost1 with (L := swap_atoms a b L).
    intros α Hα. apply swap_atoms_notin in Hα.
    specialize (IH (swap_atom a b α) Hα a b F' (add α Δ1') Δ2' HF).
    repeat rewrite swap_pskl_open_var in IH.
    simpl in IH. repeat rewrite swap_atom_invol in IH.
    apply IH; auto.
    rewrite swap_atoms_add. rewrite swap_atom_invol. rewrite H1. fsetdec.
  - (* UnivGhost2 *)
    intros F Δ1 Δ2 Θ0 Θ1 P0 P Q Hg Hnf Hc IH a b F' Δ1' Δ2' HF H1 H2. simpl.
    apply a_consis__univ_ghost2;
      auto using swap_pskl_guarded, swap_a_non_flex.
  - (* Flex *)
    intros F Δ1 Δ2 Θ0 Θ1 α β Huni IHuni a b F' Δ1' Δ2' HF H1 H2. simpl.
    apply a_consis__flex. apply (IHuni a b F' HF).
  - (* FlexL *)
    intros F Δ1 Δ2 Θ0 Θ1 α P0 Hnf Hass IHass a b F' Δ1' Δ2' HF H1 H2. simpl.
    apply a_consis__flex_l; [ apply swap_a_non_flex; auto
                            | apply (IHass a b F' HF) ].
  - (* FlexR *)
    intros F Δ1 Δ2 Θ0 Θ1 α P Hnf Hass IHass a b F' Δ1' Δ2' HF H1 H2. simpl.
    apply a_consis__flex_r; [ apply swap_a_non_flex; auto
                            | apply (IHass a b F' HF) ].
  - (* GhostR *)
    intros F Δ1 Δ2 Θ0 P Hinter a b F' Δ1' Δ2' HF H1 H2. simpl.
    apply a_consis__ghost_r.
    rewrite H1. rewrite ftvar_in_swap_pskl. apply swap_inter_empty. auto.
  - (* UnivGhostR *)
    intros F Δ1 Δ2 Θ0 Θ1 P0 P Q Hg Hnf Hc IH a b F' Δ1' Δ2' HF H1 H2. simpl.
    apply a_consis__univ_ghost_r;
      auto using swap_pskl_guarded, swap_a_non_flex.
Qed.

(** A transposition of two atoms that are both fresh for the CONTEXTS renames
    the head rigid binder of a consistency derivation (the classic
    "rename the opened binder" principle, obtained here from equivariance). *)
Lemma a_consis_transport : forall F Δ1 Δ2 Θ0 Θ1 P0 P Q a0 α,
  ((a0 ~ abind_tvar) ++ Θ0) ⊢ₐ[ F ][ Δ1 | Δ2 | P0 ] P ≈ Q
    ⊣ ((a0 ~ abind_tvar) ++ Θ1) ->
  a0 `notin` (ftvar_in_aenv Θ0 `union` ftvar_in_aenv Θ1) ->
  α `notin` (ftvar_in_aenv Θ0 `union` ftvar_in_aenv Θ1) ->
  forall F' Δ1' Δ2',
    F' [=] swap_atoms a0 α F ->
    Δ1' [=] swap_atoms a0 α Δ1 ->
    Δ2' [=] swap_atoms a0 α Δ2 ->
    ((α ~ abind_tvar) ++ Θ0) ⊢ₐ[ F' ][ Δ1' | Δ2' | (swap_pskl a0 α P0) ]
      (swap_pskl a0 α P) ≈ (swap_pskl a0 α Q) ⊣ ((α ~ abind_tvar) ++ Θ1).
Proof.
  intros * Hc Ha0 Hα * HF H1 H2.
  destruct a_auc_equiv as [_ [_ Hequiv]].
  specialize (Hequiv _ _ _ _ _ _ _ _ Hc a0 α F' Δ1' Δ2' HF H1 H2).
  simpl in Hequiv. rewrite swap_atom_l in Hequiv.
  rewrite (@swap_aenv_fresh a0 α Θ0) in Hequiv; try fsetdec.
  rewrite (@swap_aenv_fresh a0 α Θ1) in Hequiv; try fsetdec.
  exact Hequiv.
Qed.

(** The transposition [(a0 α)] realises the opening of the CLOSED witness. *)
Lemma swap_open_close : forall a0 α Q,
  α `notin` ftvar_in_pskl Q ->
  swap_pskl a0 α Q
  = open_pskl_wrt_pskl (close_pskl_wrt_pskl a0 Q) (pskl_var_f α).
Proof.
  intros a0 α Q Hα.
  rewrite swap_pskl_as_subst; auto.
  rewrite (subst_pskl_in_pskl_intro a0 (close_pskl_wrt_pskl a0 Q));
    [ | rewrite ftvar_in_pskl_close_pskl_wrt_pskl; fsetdec ].
  rewrite open_pskl_wrt_pskl_close_pskl_wrt_pskl. reflexivity.
Qed.

(** Opening a body with a fresh variable is a transposition of the body. *)
Lemma swap_open_fresh : forall a0 α P,
  a0 `notin` ftvar_in_pskl P -> α `notin` ftvar_in_pskl P ->
  swap_pskl a0 α (open_pskl_wrt_pskl P (pskl_var_f a0))
  = open_pskl_wrt_pskl P (pskl_var_f α).
Proof.
  intros. rewrite swap_pskl_open_var. rewrite swap_atom_l.
  rewrite swap_pskl_fresh; auto.
Qed.

(* ===================================================================== *)
(*  4.  SYMMETRY.                                                          *)
(* ===================================================================== *)

Definition assign_sym (F : atoms) (Θ0 Ξ : aenv) (α : atom) (P : pskl)
    (Θ1 : aenv) : Prop := True.

Definition unify_sym (F : atoms) (Θ0 : aenv) (α β : atom) (Θ1 : aenv) : Prop :=
  Θ0 ⊲[ F ] β ≈ᵘ α ⊣ Θ1.

Definition consis_sym (F Δ1 Δ2 : atoms) (Θ0 : aenv) (P0 P Q : pskl)
    (Θ1 : aenv) : Prop :=
  exists Q', Θ0 ⊢ₐ[ F ][ Δ2 | Δ1 | P ] P0 ≈ Q' ⊣ Θ1.

Lemma a_auc_sym :
  (forall F Θ0 Ξ α P Θ1, a_assign F Θ0 Ξ α P Θ1 -> assign_sym F Θ0 Ξ α P Θ1) /\
  (forall F Θ0 α β Θ1, a_unify F Θ0 α β Θ1 -> unify_sym F Θ0 α β Θ1) /\
  (forall F Δ1 Δ2 Θ0 P0 P Q Θ1, a_consis F Δ1 Δ2 Θ0 P0 P Q Θ1 ->
     consis_sym F Δ1 Δ2 Θ0 P0 P Q Θ1).
Proof.
  apply a_auc_mutind; unfold assign_sym, unify_sym, consis_sym;
    try (intros; exact I).

  (* ---------------- a_unify ---------------- *)
  - (* Flex-Flex-Id *)
    intros F Θ0 α Hflex. apply a_unify__flex_id; auto.
  - (* Flex-Flex-L  ↦  Flex-Flex-R *)
    intros F Θ0 α β Hne Hflex.
    apply a_unify__flex_r; auto.
  - (* Flex-Flex-R  ↦  Flex-Flex-L *)
    intros F Θ0 α β Hne Hflex.
    apply a_unify__flex_l; auto.
  - (* Flex-Flex-Assign: the premise's two slots swap (consistency IH) *)
    intros F Θ0 Θ1 γ τ α β Q Hfa Hfb Hcons [Q' IH].
    apply a_unify__flex_assign with (τ := τ) (Q := Q'); auto.
  - (* Flex-Flex-Skip *)
    intros F Θ0 Θ1 γ α β Hne1 Hne2 Huni IH.
    apply a_unify__flex_skip; auto.
  - (* Flex-Flex-Skip' *)
    intros F Θ0 Θ1 c bd α β Hbd Huni IH.
    apply a_unify__skip_other; auto.

  (* ---------------- a_consis ---------------- *)
  - (* Ghost  ↦  GhostR *)
    intros F Δ1 Δ2 Θ0 P0 Hinter.
    exists P0. apply a_consis__ghost_r; auto.
  - (* Unit *)
    intros F Δ1 Δ2 Θ0. exists pskl_unit. apply a_consis__unit.
  - (* Rigid *)
    intros F Δ1 Δ2 Θ0 α Hbinds.
    exists (pskl_var_f α). apply a_consis__rigid; auto.
  - (* Arrow *)
    intros F Δ1 Δ2 Θ0 Θ1 Θ2 P0a P0b P1 P2 Q1 Q2 Hc1 [Q1' IH1] Hc2 [Q2' IH2].
    exists (pskl_arrow Q1' Q2'). apply a_consis__arrow with (Θ1 := Θ1); auto.
  - (* ForallInh (self-mirror; cofinite) *)
    intros L F Δ1 Δ2 Θ0 Θ1 P0 P Q Hbody IH.
    pick fresh a0 for
      (L `union` F `union` Δ1 `union` Δ2 `union` ftvar_in_pskl P0
         `union` ftvar_in_pskl P `union` ftvar_in_pskl Q
         `union` ftvar_in_aenv Θ0 `union` ftvar_in_aenv Θ1).
    destruct (IH a0 ltac:(auto)) as [Q0 HQ0].
    exists (pskl_all_syn (close_pskl_wrt_pskl a0 Q0)).
    apply a_consis__forall_inh with
      (L := L `union` singleton a0 `union` F `union` Δ1 `union` Δ2
              `union` ftvar_in_pskl P0 `union` ftvar_in_pskl P
              `union` ftvar_in_pskl Q `union` ftvar_in_pskl Q0
              `union` ftvar_in_aenv Θ0 `union` ftvar_in_aenv Θ1).
    intros α Hα.
    apply (a_consis_transport (a0 := a0) (α := α)) with
      (F' := F) (Δ1' := add α Δ2) (Δ2' := add α Δ1) in HQ0;
      try fsetdec.
    + rewrite swap_open_fresh in HQ0; auto.
      rewrite swap_open_fresh in HQ0; auto.
      rewrite swap_open_close in HQ0; auto.
    + rewrite swap_atoms_id; fsetdec.
    + rewrite swap_atoms_add. rewrite swap_atom_l.
      rewrite swap_atoms_id; fsetdec.
    + rewrite swap_atoms_add. rewrite swap_atom_l.
      rewrite swap_atoms_id; fsetdec.
  - (* ForallSyn  ↦  UnivGhost1 (cofinite) *)
    intros L F Δ1 Δ2 Θ0 Θ1 P0 P Q Hbody IH.
    pick fresh a0 for
      (L `union` F `union` Δ1 `union` Δ2 `union` ftvar_in_pskl P0
         `union` ftvar_in_pskl P `union` ftvar_in_pskl Q
         `union` ftvar_in_aenv Θ0 `union` ftvar_in_aenv Θ1).
    destruct (IH a0 ltac:(auto)) as [Q0 HQ0].
    exists (pskl_all_syn (close_pskl_wrt_pskl a0 Q0)).
    apply a_consis__univ_ghost1 with
      (L := L `union` singleton a0 `union` F `union` Δ1 `union` Δ2
              `union` ftvar_in_pskl P0 `union` ftvar_in_pskl P
              `union` ftvar_in_pskl Q `union` ftvar_in_pskl Q0
              `union` ftvar_in_aenv Θ0 `union` ftvar_in_aenv Θ1).
    intros α Hα.
    apply (a_consis_transport (a0 := a0) (α := α)) with
      (F' := F) (Δ1' := add α Δ2) (Δ2' := Δ1) in HQ0;
      try fsetdec.
    + simpl in HQ0.
      rewrite swap_open_fresh in HQ0; auto.
      rewrite swap_pskl_fresh in HQ0; auto.
      rewrite swap_open_close in HQ0; auto.
    + rewrite swap_atoms_id; fsetdec.
    + rewrite swap_atoms_add. rewrite swap_atom_l.
      rewrite swap_atoms_id; fsetdec.
    + rewrite swap_atoms_id; fsetdec.
  - (* UnivGhost *)
    intros F Δ1 Δ2 Θ0 Θ1 P0 P Q Hc [Q' IH].
    exists (pskl_tophole Q'). apply a_consis__univ_ghost; auto.
  - (* UnivGhost1  ↦  ForallSyn (cofinite) *)
    intros L F Δ1 Δ2 Θ0 Θ1 P0 P Q Hbody IH.
    pick fresh a0 for
      (L `union` F `union` Δ1 `union` Δ2 `union` ftvar_in_pskl P0
         `union` ftvar_in_pskl P `union` ftvar_in_pskl Q
         `union` ftvar_in_aenv Θ0 `union` ftvar_in_aenv Θ1).
    destruct (IH a0 ltac:(auto)) as [Q0 HQ0].
    exists (pskl_all_syn (close_pskl_wrt_pskl a0 Q0)).
    apply a_consis__forall_syn with
      (L := L `union` singleton a0 `union` F `union` Δ1 `union` Δ2
              `union` ftvar_in_pskl P0 `union` ftvar_in_pskl P
              `union` ftvar_in_pskl Q `union` ftvar_in_pskl Q0
              `union` ftvar_in_aenv Θ0 `union` ftvar_in_aenv Θ1).
    intros α Hα.
    apply (a_consis_transport (a0 := a0) (α := α)) with
      (F' := F) (Δ1' := Δ2) (Δ2' := add α Δ1) in HQ0;
      try fsetdec.
    + simpl in HQ0.
      rewrite swap_pskl_fresh in HQ0; auto.
      rewrite swap_open_fresh in HQ0; auto.
      rewrite swap_open_close in HQ0; auto.
    + rewrite swap_atoms_id; fsetdec.
    + rewrite swap_atoms_id; fsetdec.
    + rewrite swap_atoms_add. rewrite swap_atom_l.
      rewrite swap_atoms_id; fsetdec.
  - (* UnivGhost2  ↦  UnivGhostR *)
    intros F Δ1 Δ2 Θ0 Θ1 P0 P Q Hg Hnf Hc [Q' IH].
    exists Q'. apply a_consis__univ_ghost_r; auto.
  - (* Flex (self-mirror; the output changes: α̂ ↦ β̂) *)
    intros F Δ1 Δ2 Θ0 Θ1 α β Huni IHuni.
    exists (pskl_var_f β). apply a_consis__flex; auto.
  - (* FlexL  ↦  FlexR (SAME assignment premise) *)
    intros F Δ1 Δ2 Θ0 Θ1 α P0 Hnf Hass IHass.
    exists (pskl_var_f α). apply a_consis__flex_r; auto.
  - (* FlexR  ↦  FlexL (SAME assignment premise) *)
    intros F Δ1 Δ2 Θ0 Θ1 α P Hnf Hass IHass.
    exists (pskl_var_f α). apply a_consis__flex_l; auto.
  - (* GhostR  ↦  Ghost *)
    intros F Δ1 Δ2 Θ0 P Hinter.
    exists P. apply a_consis__ghost; auto.
  - (* UnivGhostR  ↦  UnivGhost2 *)
    intros F Δ1 Δ2 Θ0 Θ1 P0 P Q Hg Hnf Hc [Q' IH].
    exists Q'. apply a_consis__univ_ghost2; auto.
Qed.
