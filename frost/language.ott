% defn
% |- dE :: :: d_wf_env :: 'd_wf_env__' by

% --------- :: empty
% |- empty

% |- dE
% X `notin` dom dE
% ---------------- :: tvar
% |- dE , X : □

% |- dE
% dE |- A
% x `notin` dom dE
% ---------------- :: typ
% |- dE , x : A


