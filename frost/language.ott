defns
J_d_wf_typ :: '' ::=

defn
dE |- A :: :: d_wf_typ :: 'd_wf_typ__' by

--------- :: unit
dE |- UNIT 

--------- :: bot
dE |- BOT 

--------- :: top
dE |- TOP

(X : □) in dE
-------------- :: tvar
dE |- X

(X : ■) in dE 
-------------- :: stvar 
dE |- X

dE |- A1
dE |- A2
-------------- :: arrow
dE |- A1 -> A2

X ∈ₛ A
dE, X : □ |- A
-------------------- :: all
dE |- ∀ X . A

