defns
J_neq_bot :: '' ::=

defn
A <> ⊥ :: :: neq_bot :: 'neq_bot__' by

------------------------ :: unit
UNIT <> ⊥

------------------------ :: top
TOP <> ⊥

------------------------ :: var
X <> ⊥

------------------------ :: arrow
A1 -> A2 <> ⊥

------------------------ :: all
∀ X . A <> ⊥

