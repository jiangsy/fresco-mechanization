% defns 
% J_d_mono_typ :: '' ::= 

% defn 
% dE |-m A :: :: d_mono_typ :: 'd_mono_typ__' by 

% (X : □) in dE
% --------------- :: tvar
% dE |-m X

% dE |-m A1
% dE |-m A2
% --------------- :: arrow
% dE |-m A1 -> A2
