defns
J_neq_abs :: '' ::= 

defn 
e <> λ :: :: neq_abs :: 'neq_abs__' by 

---------------------- :: unit
unit <> λ

---------------------- :: var
x <> λ

---------------------- :: app
e1 e2  <> λ

---------------------- :: tabs
\ X . e  <> λ

---------------------- :: tapp
e @ A <> λ

---------------------- :: anno
e : A <> λ

