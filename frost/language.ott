metavar typvar, X, Y, Z     ::= {{ repr-locally-nameless }}
metavar expvar, x, y, z     ::= {{ repr-locally-nameless }}
metavar taglabel, l         ::= {{ coq var }}

grammar


% maybe we should just unify typ and pattern in syntax, and distinguish them 
% by predicate : types cannot be constructed using ghost or topghost
pre_typ, P , Q , A , B , C , R , T , G :: pre_typ_ ::=
  | X                ::   :: var
  | T -> R           ::   :: arrow
  | ∀ X . T          ::   :: all  (+ bind X in T +)
  | *                ::   :: ghost
  | *. T             ::   :: topghost
  | [ T ] l          ::   :: tag
  | ^ T              ::   :: hat
  | ( T )            :: S :: paren {{ coq ([[T]]) }}
  | { T / X } R      :: M :: subst {{ coq (open_pre_typ_wrt_pre_typ [[X T]] [[R]]) }}

exp, e, f, g :: exp_ ::=
  | x                                   ::   :: var
  | \ x . e                             ::   :: abs  (+ bind x in e +)
  | \ x : A . e                         ::   :: abs_anno (+ bind x in e +)
  | e1 e2                               ::   :: app
  | let x = e1 in e2                    ::   :: let (+ bind x in e2 +)
  % | \ X . e                             ::   :: tabs (+ bind X in e +) 
  % | e @ A                               ::   :: tapp
  | e : A                               ::   :: anno
  | ⌈ e ⌉                               ::   :: freeze
  | ( e )                               :: S :: paren  {{ coq ([[e]]) }}
  | { e2 / x } e1                       :: M :: subsT {{ coq (open_exp_wrt_exp [[x e1]] [[e2]]) }}
  | { A2 / X } e1                       :: M :: subsR {{ coq (open_exp_wrt_typ [[X e1]] [[A2]]) }}

pat_row , p :: pat_row_ ::=
  | P , p                ::  :: cons
  | P                    ::  :: one

bind, b :: bind_ ::=
  | : □  ::   :: tvar
  | : A  ::   :: pattern

sort, s :: sort_ ::=
  | ■1   ::   :: star
  | ■2   ::   :: circ
  | ■3   ::   :: hcirc
  | ■4   ::   :: ecirc

substitutions
  single P X  :: subst_pattern_in
  single e x  :: subst_exp_in

freevars
  % A X  :: ftvar_in
  P X  :: ftvar_in
  e x  :: fvar_in
 
grammar


mode, m :: mode_ ::=
  | ty            ::   :: ty
  | ng            ::   :: ng
  | pi            ::   :: pi
  | ↓ m           :: M :: to_ty {{ coq (to_ty_mode [[ m ]]) }}

env, dE, dF, dG:: '' ::= {{ coq list (atom*bind) }}
  | empty     ::   :: dempty {{ coq nil }}
  | dE , x b  ::   :: dcons1 {{ coq ([[x]]~[[b]] ++ [[dE]])  }}
  | dE , X b  ::   :: dcons2 {{ coq ([[X]]~[[b]] ++ [[dE]])  }}

tenv, tE, tF, tG:: '' ::= {{ coq vars }}
  | empty         ::   :: tempty {{ coq empty }}
  | tE , l        ::   :: tadd {{ coq (add [[l]] [[tE]])  }}
  | ( tE )        :: M :: paren2 {{ coq ([[tE]]) }}
  | sin l         :: M :: sin {{ coq (singleton [[l]]) }}
  | tE1 ∪ tE2     :: M :: union {{ coq ([[tE1]] `union` [[tE2]]) }}

formula :: formula_ ::=
  | judgement             ::   :: judgement
  | formula \/ formula'       ::   :: judgement_or {{ coq  ([[formula]]) \/ ([[formula']]) }}
  | ( x b )  in dE    ::   :: binds1 {{ coq binds ([[x]])  ([[b]]) ([[dE]]) }}
  | ( X b )  in dE    ::   :: binds2 {{ coq binds ([[X]])  ([[b]]) ([[dE]]) }}
  | x  `notin` dom dE ::   :: fresh1 {{ coq ([[x]]  `notin` dom ([[dE]])) }}
  | X  `notin` dom dE ::   :: fresh2 {{ coq ([[X]]  `notin` dom ([[dE]])) }}
  | tE1 [=] tE2       ::   :: seteq  {{ coq ([[tE1]] [=] [[tE2]]) }}
  | m1 == m2          ::   :: modeeq {{ coq [[m1]] = [[m2]] }}
  | l `in` tE         ::   :: in1  {{ coq ([[l]] `in` [[tE]]) }}
  | p <> *            ::   :: not_ghost {{ coq ([[p]] <> pat_row_one pre_typ_ghost ) }}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

embed {{ coq 

Function to_ty_mode (m : mode) : mode :=
  match m with 
  | mode_ty => mode_ty
  | mode_ng => mode_ng
  | mode_pi => mode_ng
  end.

}}


