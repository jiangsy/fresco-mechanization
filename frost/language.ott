% tE' | dE , X : □ |- T ~ P
% tE [=] tE' , l
% ---------------------------------- :: forall
% tE | dE |- ∀ X . T ~ [ ∀ X . P ] l

% tE | dE |- P ~ T
% -------------------------- :: topghost_l1
% tE | dE |- *. P ~ T

% % ForallGhostL2 is split into topghost_l2 and topghost_l2'
