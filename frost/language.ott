% Frost — pure syntax (Phase 1 of the mechanization).
% Companion of paper/sections/declarative.tex.
% Encoding: ONE unified `typ` inductive that covers all six paper categories
% (plain, tagged, unresolved, skel, tagged-skel, unresolved-skel). Categories
% are predicates over `typ` defined in def_extra.v. No typing/subtyping/
% consistency rules here — those live in def_extra.v files.
%
% Metavar naming:
%   ott uses ASCII identifiers (Unicode in ott metavars is unreliable).
%   The Makefile's sed pass rewrites context variable names to Greek in the
%   generated def_ott.v / prop_ln.v:
%      dE → Γ   (term context)
%      dD → Δ   (tag context)
%      dP → Ψ   (skeleton-scope context)
%   ε tags use the metavar `eps` in ott; the constructor for ε-tagged ∀ is
%   renamed to `typ_all_etag` so that sed `eps → ε` doesn't mangle it.

metavar expvar, x, y, z ::= {{ repr-locally-nameless }}
metavar epsvar, eps     ::= {{ coq var }}
% Variable atoms for the new derivation-internal types (Phase A
% refactor). Each grammar gets its own ott-level typvar so lngen can
% disambiguate which substitution to generate. All alias to [typvar]
% in Coq (same atom identity, via Notation rewrites in the Makefile).
metavar ptypvar, Xpt ::= {{ repr-locally-nameless }}
metavar btypvar, Xbt ::= {{ repr-locally-nameless }}
metavar utypvar, Xut ::= {{ repr-locally-nameless }}
metavar psklvar, Xps ::= {{ repr-locally-nameless }}
metavar bsklvar, Xbs ::= {{ repr-locally-nameless }}

grammar

% Decorated type AST. Five categories (col-S, col-I, eps-tagged, plus
% unit/var/arrow/hole/tophole) — the un-decorated plain forall
% (`forall X. A`) lives in `ctyp` below, NOT in `typ`. This keeps the
% paper's distinction between *decorated* universes (where ∀ carries
% colour or tag) and the *plain* universe (where ∀ has no decoration).
%
% Algorithmic flex variables (mono α̂, poly α̌) are NOT type constructors:
% a flex var is morally an ordinary type variable [X] (typ_var_f),
% distinguished as rigid / flex-mono / flex-poly purely by its binding
% in the algorithmic context Θ (abind_tvar / abind_flex_mono /
% abind_flex_poly_def, ...). This keeps [typ] free of the
% solver-specific cases.
%
% =====================================================================
% Type-hierarchy refactor (Phase A) — new derivation-internal types.
% These coexist with `typ` during the migration; `typ` is removed in
% Phase F. See docs/superpowers/specs/2026-05-18-type-hierarchy-refactor-design.md
% =====================================================================

% Plain types — paper's "real user type" written in source annotations.
% Exactly the 5 "type" shapes: unit, var, arrow, ∀ (no colour, no tag,
% no holes). Used as the annotation type in [exp_anno] / [exp_abs_anno]
% post-refactor. Colours / tags are derivation-internal bookkeeping
% added when the typing rule paints a [ptyp] into [bid] for use in
% subtyping / consistency premises.
ptyp, N :: 'ptyp_' ::=
  | UNIT                 ::   :: unit
  | Xpt                  ::   :: var
  | N1 -> N2             ::   :: arrow
  | forall Xpt . N       ::   :: all   (+ bind Xpt in N +)
  | ( N )                :: S :: paren {{ coq ([[N]]) }}
  | { N2 / Xpt } N1      :: M :: subst {{ coq (open_ptyp_wrt_ptyp [[Xpt N1]] [[N2]]) }}

% Bidirectional types — paper's bid{T}. Derivation-internal coloured ∀s
% (no holes). The umbrella type for d_sub / d_consis / d_typing rules
% (post-refactor).
btyp, D :: 'btyp_' ::=
  | UNIT                 ::   :: unit
  | Xbt                  ::   :: var
  | D1 -> D2             ::   :: arrow
  | forall^syn Xbt . D   ::   :: all_syn   (+ bind Xbt in D +)
  | forall^inh Xbt . D   ::   :: all_inh   (+ bind Xbt in D +)
  | ( D )                :: S :: paren {{ coq ([[D]]) }}
  | { D2 / Xbt } D1      :: M :: subst {{ coq (open_btyp_wrt_btyp [[Xbt D1]] [[D2]]) }}

% Unresolved synthesised types — paper's syn{∀^δ α.}T. Subset of bid:
% only colour_syn ∀ and ε-tagged ∀ allowed (no colour_inh).
utyp, F :: 'utyp_' ::=
  | UNIT                 ::   :: unit
  | Xut                  ::   :: var
  | F1 -> F2             ::   :: arrow
  | forall^syn Xut . F   ::   :: all_syn   (+ bind Xut in F +)
  | forall@ eps Xut . F  ::   :: all_etag  (+ bind Xut in F +)
  | ( F )                :: S :: paren {{ coq ([[F]]) }}
  | { F2 / Xut } F1      :: M :: subst {{ coq (open_utyp_wrt_utyp [[Xut F1]] [[F2]]) }}

% Skeletons — for d_wf_skel, d_refine, d_pat_consis, etc.
% Broadest skeleton: matches [bid] shapes (syn / inh / etag ∀s) plus
% holes / tophole. Narrow classes (e.g. syn-only, no-etag) are
% recovered via predicates over skel.
pskel, P :: 'pskel_' ::=
  | UNIT                 ::   :: unit
  | Xps                  ::   :: var
  | P1 -> P2             ::   :: arrow
  | forall^syn Xps . P1  ::   :: all_syn (+ bind Xps in P1 +)
  | HOLE                 ::   :: hole
  | TOPHOLE . P          ::   :: tophole
  | ( P )                :: S :: paren {{ coq ([[P]]) }}
  | { P2 / Xps } P1      :: M :: subst {{ coq (open_pskel_wrt_pskel [[Xps P1]] [[P2]]) }}

bskel, R :: 'bskel_' ::=
  | UNIT                 ::   :: unit
  | Xbs                  ::   :: var
  | R1 -> R2             ::   :: arrow
  | forall^syn Xbs . R   ::   :: all_syn   (+ bind Xbs in R +)
  | forall^inh Xbs . R   ::   :: all_inh   (+ bind Xbs in R +)
  | HOLE                 ::   :: hole
  | TOPHOLE . R          ::   :: tophole
  | ( R )                :: S :: paren {{ coq ([[R]]) }}
  | { R2 / Xbs } R1      :: M :: subst {{ coq (open_bskel_wrt_bskel [[Xbs R1]] [[R2]]) }}

% Terms.
exp, e, f :: 'exp_' ::=
  | unit                    ::   :: unit
  | x                       ::   :: var
  | \ x . e                 ::   :: abs       (+ bind x in e +)
  | \ x : N . e             ::   :: abs_anno  (+ bind x in e +)
  | e1 e2                   ::   :: app
  | e : N                   ::   :: anno
  | freeze e                ::   :: freeze
  | ( e )                   :: S :: paren {{ coq ([[e]]) }}
  | { e2 / x } e1           :: M :: subste {{ coq (open_exp_wrt_exp [[x e1]] [[e2]]) }}
  | { N / Xpt } e           :: M :: substt {{ coq (open_exp_wrt_ptyp [[Xpt e]] [[N]]) }}

% Modes M ::= TI | TC | FN M.
mode, m :: 'mode_' ::=
  | TI         ::   :: ti
  | TC         ::   :: tc
  | FN m       ::   :: fn

substitutions
  single N Xpt  :: subst_ptyp_in
  single D Xbt  :: subst_btyp_in
  single F Xut  :: subst_utyp_in
  single P Xps  :: subst_pskl_in
  single R Xbs  :: subst_bskl_in
  single e x    :: subst_exp_in
  single e Xpt  :: subst_typ_in

freevars
  N Xpt :: ftvar_in
  D Xbt :: ftvar_in
  F Xut :: ftvar_in
  P Xps :: ftvar_in
  R Xbs :: ftvar_in
  e Xpt :: ftvar_in
  e x   :: fvar_in

embed
{{ coq

Inductive dbind : Set := 
 | dbind_tvar : dbind
 | dbind_typ (N:ptyp)
 | dbind_skel (P:pskel).

Definition tagctx : Set := list atom.

Definition psienv : Set := list atom.

Definition denv : Set := list (atom*dbind).
}}

embed
{{ coq

(* Forward declaration used in formulae; full definition lives in def_extra.v.
   We pre-declare it here so def_ott.v compiles standalone. *)
Definition list_disjoint (xs ys : list atom) : Prop :=
  forall a, List.In a xs -> ~ List.In a ys.

}}
