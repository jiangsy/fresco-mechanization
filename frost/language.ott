defns
J_d_wf_exp :: '' ::=

defn
dE |- e :: :: d_wf_exp :: 'd_wf_exp__' by

--------- :: unit
dE |- unit 

(x : A) in dE  
----------------- :: var
dE |- x 

dE |- T
dE , x : T |- e
----------------- :: abs
dE |- \ x . e

dE |- e1
dE |- e2
----------------- :: app
dE |- e1 e2

X ∈ₛ A
dE , X : □ |- e : A
----------------- :: tabs 
dE |- \ X . ( e : A )

dE |- A
dE |- e
----------------- :: tapp 
dE |- e @ A

dE |- A
dE |- e
----------------- :: anno 
dE |- e : A


