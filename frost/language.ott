% P -> Q ▹ P -> Q

% P ▹ Q1 --> Q2
% ----------------- :: forall
% ∀ P ▹ ∀ Q1 --> Q2

% defns
% pat_refine :: '' ::=
% defn
% p1 [▹] p2 :: :: pat_refining :: 'pat_refining__' by

