tE1 | dE |- P /\ T1 ~ R1 
tE2 | dE |- Q /\ T2 ~ R2
tE1 ∪ tE2 [=] tE
------------------------------------ :: arrow
tE | dE |- P -> Q /\ T1 -> T2 ~ R1 -> R2 

tE1 | dE |- P /\ T1 ~ R1
tE2 | dE |- Q /\ T2 ~ R2
(tE1 ∪ tE2) , l [=] tE
------------------------------------ :: arrow'
tE | dE |- P -> Q /\ [ T1 -> T2 ] l ~ R1 -> R2

