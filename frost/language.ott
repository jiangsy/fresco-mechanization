% Frost — pure syntax (Phase 1 of the mechanization).
% Companion of paper/sections/declarative.tex.
% Encoding: ONE unified `typ` inductive that covers all six paper categories
% (plain, tagged, unresolved, skel, tagged-skel, unresolved-skel). Categories
% are predicates over `typ` defined in def_extra.v. No typing/subtyping/
% consistency rules here — those live in def_extra.v files.
%
% Metavar naming:
%   ott uses ASCII identifiers (Unicode in ott metavars is unreliable).
%   The Makefile's sed pass rewrites context variable names to Greek in the
%   generated def_ott.v / prop_ln.v:
%      dE → Γ   (term context)
%      dD → Δ   (tag context)
%      dP → Ψ   (skeleton-scope context)
%   ε tags use the metavar `eps` in ott; the constructor for ε-tagged ∀ is
%   renamed to `typ_all_etag` so that sed `eps → ε` doesn't mangle it.

metavar typvar, X, Y, Z ::= {{ repr-locally-nameless }}
metavar expvar, x, y, z ::= {{ repr-locally-nameless }}
metavar epsvar, eps     ::= {{ coq var }}
% Flex-mono and flex-poly type variable names. These are NOT
% locally-nameless: they are plain atoms because in the algorithmic
% system they are top-level entries in the algorithmic context Θ, not
% binders inside type structure.
metavar monovar, monvar ::= {{ coq var }}
metavar polyvar, polvar ::= {{ coq var }}

grammar

% Bidirectional colour annotation on plain ∀'s.
colour, c :: 'colour_' ::=
  | S    ::   :: syn
  | I    ::   :: inh

% Unified type AST. Six paper categories carved out by predicates in
% def_extra.v. The four ∀ flavours (col-S, col-I, eps-tagged, plain) are
% distinct constructors so category predicates can discriminate cleanly.
%
% Metavar aliases follow the paper:
%   A, B, C, T  — plain types / unresolved types
%   ph          — tagged types (paper's φ)
%   ps          — tagged skeletons (paper's ψ)
%   P, Q        — skeletons
%   SS          — unresolved skeletons (paper's S; doubled to avoid clash
%                 with the colour constructor S)
typ, A, B, C, T, ph, ps, P, Q, SS :: 'typ_' ::=
  | UNIT                ::   :: unit
  | X                   ::   :: var
  | A1 -> A2            ::   :: arrow
  | forall^ c X . A     ::   :: all_col   (+ bind X in A +)
  | forall@ eps X . A   ::   :: all_etag  (+ bind X in A +)
  | forall X . A        ::   :: all_plain (+ bind X in A +)
  | HOLE                ::   :: hole
  | TOPHOLE . A         ::   :: tophole
  | hat monvar          ::   :: var_flex_mono
  | check polvar        ::   :: var_flex_poly
  | ( A )               :: S :: paren {{ coq ([[A]]) }}
  | { A2 / X } A1       :: M :: subst {{ coq (open_typ_wrt_typ [[X A1]] [[A2]]) }}

% Terms.
exp, e, f :: 'exp_' ::=
  | unit                    ::   :: unit
  | x                       ::   :: var
  | \ x . e                 ::   :: abs       (+ bind x in e +)
  | \ x : A . e             ::   :: abs_anno  (+ bind x in e +)
  | e1 e2                   ::   :: app
  | e : A                   ::   :: anno
  | freeze e                ::   :: freeze
  | ( e )                   :: S :: paren {{ coq ([[e]]) }}
  | { e2 / x } e1           :: M :: subste {{ coq (open_exp_wrt_exp [[x e1]] [[e2]]) }}
  | { A / X } e             :: M :: substt {{ coq (open_exp_wrt_typ [[X e]] [[A]]) }}

% Modes M ::= TI | TC | FN M.
mode, m :: 'mode_' ::=
  | TI         ::   :: ti
  | TC         ::   :: tc
  | FN m       ::   :: fn

% Term-context bindings: dbind ::= : □ | : A | : P  (both A and P are typ).
dbind, db :: 'dbind_' ::=
  | : box   ::   :: tvar
  | : A     ::   :: typ
  | : P     ::   :: skel

substitutions
  single A X :: subst_typ_in
  single e x :: subst_exp_in
  single e X :: subst_typ_in

freevars
  A X :: ftvar_in
  e X :: ftvar_in
  e x :: fvar_in

grammar

% Term context Γ : list (atom * dbind) — already in Set.
% Variable name `dE` is sed-renamed to `Γ` in def_ott.v / prop_ln.v.
denv, dE :: '' ::= {{ coq list (atom*dbind) }}
  | empty       ::   :: dempty {{ coq nil }}
  | dE , x db   ::   :: dconsx  {{ coq ([[x]]~[[db]] ++ [[dE]])  }}
  | dE , X db   ::   :: dconsX  {{ coq ([[X]]~[[db]] ++ [[dE]])  }}
  | ( dE )      :: S :: paren   {{ coq ([[dE]]) }}

% Skeleton-scope context Ψ : list atom (predicative; in Set).
% Variable name `dP` is sed-renamed to `Ψ`.
psienv, dP :: '' ::= {{ coq list atom }}
  | empty        ::   :: pempty {{ coq nil }}
  | dP , X       ::   :: pcons  {{ coq ([[X]] :: [[dP]]) }}
  | sin X        :: M :: psin   {{ coq ([[X]] :: nil) }}
  | ( dP )       :: S :: pparen {{ coq ([[dP]]) }}

% Tag context Δ : list atom (predicative; in Set).
% Variable name `dD` is sed-renamed to `Δ`.
tagctx, dD :: '' ::= {{ coq list atom }}
  | empty       ::   :: tempty {{ coq nil }}
  | dD , eps    ::   :: tcons  {{ coq ([[eps]] :: [[dD]]) }}
  | sin eps     :: M :: tsin   {{ coq ([[eps]] :: nil) }}
  | dD1 ∪ dD2   :: M :: tunion {{ coq ([[dD1]] ++ [[dD2]]) }}
  | ( dD )      :: S :: tparen {{ coq ([[dD]]) }}

formula :: formula_ ::=
  | judgement                   ::   :: judgement
  | formula \/ formula'         ::   :: judgement_or  {{ coq (([[formula]]) \/ ([[formula']])) }}
  | ! formula                   ::   :: judgement_not {{ coq (~ [[formula]]) }}
  | ( x db )  in dE             ::   :: bindsx  {{ coq binds ([[x]]) ([[db]]) ([[dE]]) }}
  | ( X db )  in dE             ::   :: bindsX  {{ coq binds ([[X]]) ([[db]]) ([[dE]]) }}
  | x  `notin` dom dE           ::   :: freshx  {{ coq ([[x]] `notin` dom ([[dE]])) }}
  | X  `notin` dom dE           ::   :: freshX  {{ coq ([[X]] `notin` dom ([[dE]])) }}
  | X  `in`  dP                 ::   :: pin     {{ coq (List.In ([[X]]) ([[dP]])) }}
  | eps `in`  dD                ::   :: tin     {{ coq (List.In ([[eps]]) ([[dD]])) }}
  | dD1 disjoint dD2            ::   :: tdisjoint {{ coq (list_disjoint ([[dD1]]) ([[dD2]])) }}
  | m1 == m2                    ::   :: modeeq  {{ coq [[m1]] = [[m2]] }}
  | c1 == c2                    ::   :: coleq   {{ coq [[c1]] = [[c2]] }}

embed
{{ coq

(* Forward declaration used in formulae; full definition lives in def_extra.v.
   We pre-declare it here so def_ott.v compiles standalone. *)
Definition list_disjoint (xs ys : list atom) : Prop :=
  forall a, List.In a xs -> ~ List.In a ys.

}}
