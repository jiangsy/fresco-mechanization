defns
J_neq_all :: '' ::=

defn
A <> ∀ :: :: neq_all :: 'neq_all__' by

------------------------ :: unit
UNIT <> ∀

------------------------ :: top
TOP <> ∀

------------------------ :: bot
BOT <> ∀

------------------------ :: var
X <> ∀

------------------------ :: arrow
A1 -> A2 <> ∀

