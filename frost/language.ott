metavar typvar, X, Y, Z     ::= {{ repr-locally-nameless }}
metavar expvar, x, y, z     ::= {{ repr-locally-nameless }}

grammar


% maybe we should just unify typ and pattern in syntax, and distinguish them 
% by predicate : types cannot be constructed using ghost or topghost
pre_typ, P , Q , A , B , C , S , T :: pre_typ_ ::=
  | X              ::   :: var
  | S -> T         ::   :: arrow
  | ∀ X . S        ::   :: all  (+ bind X in S +)
  | *              ::   :: ghost
  | *. S           ::   :: topghost
  | [ T ]          ::   :: tag
  | ( T )          :: S :: paren {{ coq ([[T]]) }}
  | { S / X } T  :: M :: subst {{ coq (open_pre_typ_wrt_pre_typ [[X S]] [[T]]) }}

exp, e, f, g :: exp_ ::=
  | x                                   ::   :: var
  | \ x . e                             ::   :: abs  (+ bind x in e +)
  | \ x : A . e                         ::   :: abs_anno (+ bind x in e +)
  | e1 e2                               ::   :: app
  | let x = e1 in e2                    ::   :: let (+ bind x in e2 +)
  % | \ X . e                             ::   :: tabs (+ bind X in e +) 
  % | e @ A                               ::   :: tapp
  | e : A                               ::   :: anno
  | ⌈ e ⌉                               ::   :: freeze
  | ( e )                               :: S :: paren  {{ coq ([[e]]) }}
  | { e2 / x } e1                       :: M :: subst1 {{ coq (open_exp_wrt_exp [[x e1]] [[e2]]) }}
  | { A2 / X } e1                       :: M :: subst2 {{ coq (open_exp_wrt_typ [[X e1]] [[A2]]) }}

pat_row , p :: pattern_row_ ::=
  | P , p                ::  :: cons
  | P                    ::  :: one

bind, b :: bind_ ::=
  | : □  ::   :: tvar_empty
  | : A  ::   :: pattern

substitutions
  single P X  :: subst_pattern_in
  single e x  :: subst_exp_in

freevars
  % A X  :: ftvar_in
  P X  :: ftvar_in
  e x  :: fvar_in
 
grammar

denv, dE, dF, dG:: '' ::= {{ coq list (atom*bind) }}
  | empty    ::   :: dempty {{ coq nil }}
  | dE , x b  ::   :: dcons1 {{ coq ([[x]]~[[b]] ++ [[dE]])  }}
  | dE , X b  ::   :: dcons2 {{ coq ([[X]]~[[b]] ++ [[dE]])  }}

formula :: formula_ ::=
  | judgement             ::   :: judgement
  | formula \/ formula'       ::   :: judgement_or {{ coq  ([[formula]]) \/ ([[formula']]) }}
  | ( x b )  in dE    ::   :: binds1 {{ coq binds ([[x]])  ([[b]]) ([[dE]]) }}
  | ( X b )  in dE    ::   :: binds2 {{ coq binds ([[X]])  ([[b]]) ([[dE]]) }}
  | x  `notin` dom dE ::   :: fresh1 {{ coq ([[x]]  `notin` dom ([[dE]])) }}
  | X  `notin` dom dE ::   :: fresh2 {{ coq ([[X]]  `notin` dom ([[dE]])) }}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%


defns
is_typ :: '' ::=

defn
|-ᵗ A :: :: is_typ :: 'is_typ__' by

-------------- :: tvar
|-ᵗ X

|-ᵗ A
|-ᵗ B
-------------- :: arrow
|-ᵗ A -> B

|-ᵗ A
-------------------- :: all
|-ᵗ ∀ X . A


defns
is_pattern :: '' ::=

defn
|-ᵖ P :: :: is_pattern :: 'is_pattern__' by

-------------- :: tvar
|-ᵖ X

|-ᵖ P
|-ᵖ Q
-------------- :: arrow
|-ᵖ P -> Q

|-ᵖ P
-------------------- :: all
|-ᵖ ∀ X . P

-------------------- :: ghost
|-ᵖ *

|-ᵖ P
-------------------- :: topghost
|-ᵖ *. P


defns
mono_typ :: '' ::=

defn
|-m A :: :: mono_typ :: 'mono_typ__' by

-------------- :: tvar
|-m X

|-m A1
|-m A2
-------------- :: arrow
|-m A1 -> A2


defns
is_exp :: '' ::=

defn
|- e :: :: is_exp :: 'is_exp__' by

-------------- :: var
|- x

|- e
-------------- :: abs
|- \ x . e


|-ᵗ A
|- e
-------------- :: abs_anno
|- \ x : A . e

|- e1 
|- e2
-------------- :: app
|- e1 e2


|- e1 
|- e2
-------------- :: let
|- let x = e1 in e2


|-ᵗ A 
|- e 
-------------- :: anno
|- e : A 


-------------- :: freeze
|- ⌈ x ⌉     


% We have to add a wrapper to the results of pat_refine
% because its results can have to different types:
% (1) a single pattern, due to the forall case of the single case
% (2) a pattern and a pattern row, due to the row cons case
% these two types are incompatible as is

% defns
% single_pat_refine :: '' ::=
% defn
% P ▹ Q :: :: sin_pat_refining :: 'sin_pat_refining__' by

% ----------------- :: ghost
% * ▹ * -> *

% ----------------- :: arrow
% P -> Q ▹ P -> Q

% P ▹ Q1 --> Q2
% ----------------- :: forall
% ∀ P ▹ ∀ Q1 --> Q2

% defns
% pat_refine :: '' ::=
% defn
% p1 [▹] p2 :: :: pat_refining :: 'pat_refining__' by

% P ▹ P
% ----------------- :: sing
% P [▹] P 

% ----------------- :: cons
% P , p [▹] P ---> p 