comp_checking :: '' ::=

defn
tE | dE |- T ~ R :: :: comp_checking :: 'comp_checking__' by

------------------- :: ghost_l
empty | dE |- * ~ T

------------------- :: ghost_r
empty | dE |- P ~ *

------------------- :: ghost_var
tE | dE |- X ~ X

sin l [=] tE
------------------- :: ghost_var'
tE | dE |- X ~ [ X ] l

tE' | dE , X : □ |- T ~ P
tE [=] tE' , l
---------------------------------- :: forall
tE | dE |- ∀ X . T ~ [ ∀ X . P ] l

tE | dE |- P ~ T
-------------------------- :: topghost_l1
tE | dE |- *. P ~ T

% ForallGhostL2 is split into topghost_l2 and topghost_l2'
tE | dE , X : □ |- P ~ T
---------------------------- :: topghost_l2
tE | dE |- *. P ~ ∀ X . T

tE | dE |- *. P ~ T
------------------------------- :: topghost_l2'
tE | dE |- *. P ~ [ *. T ] l

tE | dE |- *. P ~ T
------------------------------- :: topghost_l3
tE | dE |- *. P ~ ^ *. T

tE | dE |- P ~ T
------------------------------ :: topghost_r1
tE | dE |- P ~ *. T

tE | dE , X : □ |- P ~ *. T
---------------------------- :: topghost_r2
tE | dE |- ∀ X . P ~ *. T

tE1 | dE |- P ~ T
tE2 | dE |- Q ~ R
tE1 ∪ tE2 [=] tE
------------------------------------ :: arrow
tE | dE |- P -> Q ~ T -> R

tE1 | dE |- P ~ T
tE2 | dE |- Q ~ R
(tE1 ∪ tE2) , l [=] tE
------------------------------------ :: arrow'
tE | dE |- P -> Q ~ [ T -> R ] l

