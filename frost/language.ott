defns 
J_d_wf_cont :: '' ::= 

defn 
dE |- cs :: :: d_wf_conts :: 'd_wf_conts__' by 

dE |- cd
----------------- :: infabs
dE |- _ ▹ cd

dE |- A 
dE |- cs
-------------------- :: inftapp
dE |- _ ○ A =>=> cs  

dE |- A 
-------------------- :: sub
dE |- _ <: A  

defn 
dE |- cd :: :: d_wf_contd :: 'd_wf_contd__' by 

dE |- e 
dE |- cs
-------------------- :: infapp
dE |- _ • e =>=> cs  

defns 
J_d_wf_work :: '' ::= 

defn 
dE |- w :: :: d_wf_work :: 'd_wf_work__' by 

dE |- e
dE |- cs
----------------- :: infer
dE |- e => cs

dE |- e
dE |- A
------------------ :: check
dE |- e <= A

dE |- A 
dE |- cd
-------------------- :: infabs
dE |- A ▹ cd  

dE |- A -> B
dE |- e
dE |- cs
------------------------- :: infapp
dE |- A ~> B • e =>=> cs    

dE |- A1
dE |- A2
dE |- cs
---------------------------- :: inftapp
dE |- A1 ○ A2 =>=> cs  

dE |- A
dE |- B 
-------------------- :: sub
dE |- A <: B  

dE |- A
dE |- cs
-------------------- :: apply
dE |- cs $$ A

dE |- A
dE |- B
dE |- cd
-------------------- :: apply2
dE |- cd $ A $ B

